{
  "name": "flowsvg-native-example",
  "private": true,
  "type": "module",
  "dependencies": {
    "flowsvg": "workspace:*",
    "@flowsvg/showcase": "workspace:*"
  },
  "scripts": {
    "dev": "pnpm --filter @flowsvg/showcase build && vite",
    "build": "pnpm --filter @flowsvg/showcase build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:showcase": "vitest run acceptance --maxWorkers=1"
  },
  "devDependencies": {
    "vite": "^7.1.12",
    "playwright-core": "1.58.2",
    "@types/node": "22.19.1"
  }
}
