{
  "version": 1,
  "title": "Report generation with measured document labels",
  "viewport": {
    "width": 900,
    "height": 650
  },
  "nodes": [
    {
      "id": "group",
      "kind": "group",
      "x": 20,
      "y": 20,
      "width": 860,
      "height": 600,
      "label": "Report generation"
    },
    {
      "id": "process",
      "kind": "roundedRect",
      "parentId": "group",
      "x": 200,
      "y": 40,
      "width": 200,
      "height": 60,
      "label": "Generate report"
    },
    {
      "id": "report",
      "kind": "document",
      "parentId": "group",
      "x": 180,
      "y": 160,
      "width": 240,
      "height": 108,
      "label": "Report ready"
    },
    {
      "id": "overflow",
      "kind": "document",
      "parentId": "group",
      "x": 40,
      "y": 330,
      "width": 160,
      "height": 50,
      "label": "This report description is intentionally too long",
      "visible": false
    }
  ],
  "edges": [
    {
      "id": "generated",
      "from": "process",
      "to": "report",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ],
  "scenes": [
    {
      "id": "report-generation",
      "label": "Report generation",
      "beats": [
        {
          "durationMs": 1000,
          "caption": "Measure the report label versions before assigning height.",
          "actions": []
        },
        {
          "durationMs": 1000,
          "transitionMs": 1000,
          "caption": "The label remains above the wave while its group and dimensions change.",
          "actions": [
            {
              "type": "updateNode",
              "target": "group",
              "value": {
                "x": 40,
                "y": 40
              }
            },
            {
              "type": "updateNode",
              "target": "report",
              "value": {
                "label": "Revenue\nBy region\nFinal report",
                "width": 280,
                "height": 148,
                "stroke": "#2563eb"
              }
            },
            {
              "type": "highlight",
              "target": "report"
            }
          ]
        },
        {
          "durationMs": 1000,
          "caption": "An undersized document clips text and reports overflow.",
          "actions": [
            {
              "type": "show",
              "target": "overflow"
            },
            {
              "type": "unhighlight",
              "target": "report"
            }
          ]
        },
        {
          "durationMs": 1000,
          "caption": "Visibility updates apply to the complete report artifact.",
          "actions": [
            {
              "type": "hide",
              "target": "report"
            }
          ]
        }
      ]
    }
  ]
}
