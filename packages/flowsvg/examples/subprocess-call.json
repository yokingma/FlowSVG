              }
            },
            {
              "type": "highlight",
              "target": "call"
            }
          ]
        },
        {
          "durationMs": 1000,
          "caption": "An intentionally undersized label is clipped and diagnosed.",
          "actions": [
            {
              "type": "show",
              "target": "overflow"
            },
            {
              "type": "unhighlight",
              "target": "call"
