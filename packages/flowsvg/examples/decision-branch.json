{
  "version": 1,
  "title": "Decision branch with measured labels",
  "viewport": {
    "width": 900,
    "height": 650
  },
  "nodes": [
    {
      "id": "group",
      "kind": "group",
      "x": 20,
      "y": 20,
      "width": 860,
      "height": 600,
      "label": "Approval flow"
    },
    {
      "id": "request",
      "kind": "rect",
      "parentId": "group",
      "x": 320,
      "y": 40,
      "width": 180,
      "height": 60,
      "label": "Incoming request"
    },
    {
      "id": "decision",
      "kind": "diamond",
      "parentId": "group",
      "x": 290,
      "y": 140,
      "width": 240,
      "height": 208,
      "label": "Request approved?"
    },
    {
      "id": "review",
      "kind": "rect",
      "parentId": "group",
      "x": 40,
      "y": 450,
      "width": 180,
      "height": 72,
      "label": "Review request"
    },
    {
      "id": "issue",
      "kind": "roundedRect",
      "parentId": "group",
      "x": 600,
      "y": 450,
      "width": 180,
      "height": 72,
      "label": "Issue access token"
    },
    {
      "id": "overflow",
      "kind": "diamond",
      "parentId": "group",
      "x": 40,
      "y": 160,
      "width": 160,
      "height": 80,
      "label": "This explanation is intentionally too long",
      "visible": false
    }
  ],
  "edges": [
    {
      "id": "request-check",
      "from": "request",
      "to": "decision",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "approved",
      "from": "decision",
      "to": "issue",
      "route": "curved",
      "fromPort": "right",
      "toPort": "top",
      "label": "Approved"
    },
    {
      "id": "declined",
      "from": "decision",
      "to": "review",
      "route": "orthogonal",
      "fromPort": "left",
      "toPort": "top",
      "label": "Review"
    }
  ],
  "scenes": [
    {
      "id": "approval",
      "label": "Approval",
      "beats": [
        {
          "durationMs": 1000,
          "caption": "Decision labels use a measured shared height.",
          "actions": []
        },
        {
          "durationMs": 1000,
          "transitionMs": 1000,
          "caption": "A longer label and resize keep the current contour and clip.",
          "actions": [
            {
              "type": "updateNode",
              "target": "decision",
              "value": {
                "label": "Does request satisfy policy?",
                "width": 280
              }
            },
            {
              "type": "highlight",
              "target": "decision"
            }
          ]
        },
        {
          "durationMs": 1000,
          "transitionMs": 300,
          "caption": "An intentionally undersized node clips text and reports overflow.",
          "actions": [
            {
              "type": "show",
              "target": "overflow"
            },
            {
              "type": "unhighlight",
              "target": "decision"
            }
          ]
        }
      ]
    }
  ]
}
