{
  "version": 1,
  "title": "Input and output with measured labels",
  "viewport": {
    "width": 760,
    "height": 520
  },
  "nodes": [
    {
      "id": "group",
      "kind": "group",
      "x": 20,
      "y": 20,
      "width": 720,
      "height": 460,
      "label": "Input / output"
    },
    {
      "id": "input",
      "kind": "parallelogram",
      "parentId": "group",
      "x": 240,
      "y": 60,
      "width": 240,
      "height": 64,
      "label": "Read request payload"
    },
    {
      "id": "process",
      "kind": "rect",
      "parentId": "group",
      "x": 260,
      "y": 200,
      "width": 200,
      "height": 72,
      "label": "Process request"
    },
    {
      "id": "output",
      "kind": "parallelogram",
      "parentId": "group",
      "x": 240,
      "y": 340,
      "width": 240,
      "height": 64,
      "label": "Return response"
    },
    {
      "id": "overflow",
      "kind": "parallelogram",
      "parentId": "group",
      "x": 40,
      "y": 180,
      "width": 140,
      "height": 36,
      "label": "This explanation is intentionally too long",
      "visible": false
    }
  ],
  "edges": [
    {
      "id": "read",
      "from": "input",
      "to": "process",
      "fromPort": "bottom",
      "toPort": "top",
      "route": "straight"
    },
    {
      "id": "return",
      "from": "process",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top",
      "route": "orthogonal"
    }
  ],
  "scenes": [
    {
      "id": "io",
      "label": "Input and output",
      "beats": [
        {
          "durationMs": 1000,
          "caption": "Input and output labels share measured safe-area layout.",
          "actions": []
        },
        {
          "durationMs": 1000,
          "transitionMs": 1000,
          "caption": "A longer label and resize preserve the slanted contour.",
          "actions": [
            {
              "type": "updateNode",
              "target": "input",
              "value": {
                "label": "Read validated request payload",
                "width": 280
              }
            },
            {
              "type": "highlight",
              "target": "input"
            }
          ]
        },
        {
          "durationMs": 1000,
          "transitionMs": 300,
          "caption": "A short node clips excess text and reports overflow.",
          "actions": [
            {
              "type": "show",
              "target": "overflow"
            },
            {
              "type": "unhighlight",
              "target": "input"
            }
          ]
        }
      ]
    }
  ]
}
